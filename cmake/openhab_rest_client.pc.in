prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: openhab_rest_client
Description: C client for the openHAB REST API
Version: @PROJECT_VERSION@
Requires: libcurl libcjson
Libs: -L${libdir} -lopenhab_rest_client
Cflags: -I${includedir}
